PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/ragdb

# Redis — local: redis://localhost:6379 | Redis Cloud: rediss://default:<password>@<host>:<port>
REDIS_URL=rediss://default:YOUR_PASSWORD@your-host.redis.cloud:PORT

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# OpenAI
OPENAI_API_KEY=sk-...

# Pinecone
PINECONE_API_KEY=...
PINECONE_INDEX=rag-model

# Ingestion
INGESTION_CONCURRENCY=3
